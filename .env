# Railway MySQL connection URL (takes priority over the DB_* values below).
# Set the real value in your hosting provider's environment variables, NOT in this committed file.
#  - Backend running on Railway: use the private URL (host mysql.railway.internal)
#  - Backend running anywhere else (Netlify, local): use Railway's MYSQL_PUBLIC_URL (host *.proxy.rlwy.net)
# MYSQL_URL=mysql://USER:PASSWORD@HOST:PORT/grasha_pharma_db

# MySQL Database Credentials
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=root
DB_NAME=grasha_pharma_db
DB_PORT=3306

# Node Server Port
PORT=3000

# Google OAuth Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
